# 数学冒险王 环境变量范本
# 复制成 .env（本机）或填写在 Render 的 Environment 设定中。不要把真正的 .env 上传到 GitHub。

# PostgreSQL 连接字符串（Neon 在 Dashboard → Connection Details 复制，结尾要有 sslmode=require）
DATABASE_URL=postgresql://用户名:密码@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 用来签名教师登录 Cookie 的密钥：至少 32 个字符的随机字符串
# 可在终端执行：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 第一次启动时自动建立的管理员账户（建立后可以删除这两行，或在网站里修改密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=数学老师

# 生产环境
NODE_ENV=production
# PORT=3000          # Render 会自动设定
# DB_POOL_MAX=5      # 数据库连接数上限（Neon 免费方案建议 5）
# TRUST_PROXY=true   # 在 Render / Vercel 等代理后面运行时保持 true
